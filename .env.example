# Supabase public browser-safe values
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-only secrets. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Future integrations
OPENAI_API_KEY=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
CRON_SECRET=""

# Temporary admin sign-in mapping. Values are server-only and stored as Vercel Secrets in production.
ADMIN_LOGIN_USERNAME="admin"
ADMIN_LOGIN_EMAIL="platform-admin@example.com"

